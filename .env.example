# Hack Club Auth app credentials (https://auth.hackclub.com)
CLIENT_ID=
CLIENT_SECRET=
# random string used to sign the session cookie: openssl rand -hex 32
SESSION_SECRET=
# public origin of the site, used for the OAuth redirect (no trailing slash; defaults to the request origin)
APP_URL=
# Airtable personal access token with data.records:read/write on the Snowglobe base
AIRTABLE_API_KEY=
# defaults to the Snowglobe base (appP8Yyjc3WshfvJg)
AIRTABLE_BASE_ID=
# secret iCal address of the Google Calendar holding the schedule (Calendar settings → the calendar →
# "Secret address in iCal format"). events titled "Snowglobe…" on nov 20–22 become the schedule.
GOOGLE_CALENDAR_ICS_URL=
# optional overrides for event times (ISO, e.g. 2026-11-22T16:00:00-08:00)
SUBMISSIONS_CLOSE_AT=
# when the final vote (one favorite from the top 5) opens; ranked voting closes at the same moment
FINALS_OPEN_AT=
# local dev only: which attendee the placeholder login acts as (an email from lib/attendees.json)
DEV_ATTENDEE_EMAIL=
